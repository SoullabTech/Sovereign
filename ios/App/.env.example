# ios
# ios/App/.env.example — App Store Connect API key for TestFlight uploads
#
# Copy this to ios/App/.env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
#
# How to get these values: see docs/ios_testflight.md

# ── Required ──────────────────────────────────────────────────────────────────

# Key ID — the short alphanumeric ID shown in App Store Connect
# App Store Connect → Users and Access → Integrations → App Store Connect API
ASC_KEY_ID=

# Issuer ID — the UUID shown at the top of the API Keys page (same for all keys)
ASC_ISSUER_ID=

# ── Choose ONE of the two key options below ───────────────────────────────────

# Option A (recommended): base64-encoded .p8 key content
# Generate: base64 -i ~/Downloads/AuthKey_YOURKEYID.p8 | tr -d '\n'
# Paste the single-line result here.
ASC_KEY_CONTENT=

# Option B: path to the .p8 file on disk
# Use an absolute path. Leave blank if using ASC_KEY_CONTENT above.
ASC_KEY_PATH=
