{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "tests/constitutional/writers-studio/**/*.ts",
    "lib/manuscript/developmentalReading/observationIdentity.ts",
    "lib/manuscript/developmentalReading/freeze.ts",
    "lib/manuscript/developmentalReading/contract.ts",
    "lib/manuscript/developmentalReading/observationAddress.ts"
  ]
}
