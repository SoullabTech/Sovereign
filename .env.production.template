# ═══════════════════════════════════════════════════════════════════════════════
# MAIA Sovereign - Production Environment Template
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env.production and fill in your values
# NEVER commit .env.production to git
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL - runs in Docker container)
# ─────────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_hex_32
DATABASE_URL=postgresql://soullab:${POSTGRES_PASSWORD}@postgres:5432/maia_consciousness

# ─────────────────────────────────────────────────────────────────────────────────
# CORE APPLICATION
# ─────────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Your production domain (no trailing slash)
BASE_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com

# MAIA API Service URL (for frontend API calls)
NEXT_PUBLIC_API_URL=https://api.soullab.life

# ─────────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────────
# Anthropic Claude (primary AI)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Ollama (local LLM - runs on host or in container)
# If Ollama runs on the same machine as Docker:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# If Ollama runs in a container (uncomment ollama service in docker-compose):
# OLLAMA_BASE_URL=http://ollama:11434

# ─────────────────────────────────────────────────────────────────────────────────
# VOICE SYSTEM
# ─────────────────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_REPLACE_ME
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Voice configuration
VOICE_PRIMARY=elevenlabs
VOICE_TIMEOUT_MS=30000
VOICE_FAIL_FAST=true

# ─────────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_64

# Generate with: openssl rand -hex 32
MAIA_AUDIT_FINGERPRINT_SECRET=GENERATE_WITH_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────────
# Cognitive events logging (enable after running migrations 016+017)
MAIA_ENABLE_COGNITIVE_TURN_EVENTS=0

# Memory system
NEXT_PUBLIC_MEMORY_REFERENCES_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────────
# SOVEREIGNTY ENFORCEMENT
# ─────────────────────────────────────────────────────────────────────────────────
SOVEREIGNTY_MODE=true
FORCE_LOCAL_EMBEDDINGS=true

# Spiralogic consciousness framework
ORCHESTRATOR=spiralogic
SPIRALOGIC_ENABLED=true
SPIRALOGIC_HARD_BUDGET_MS=700
SPIRALOGIC_SOFT_BUDGET_MS=450

# ─────────────────────────────────────────────────────────────────────────────────
# SOVEREIGNTY AUDITING
# ─────────────────────────────────────────────────────────────────────────────────
# Enable to expose provider metadata in responses (proves "which AI served this")
# Set to 1 temporarily to verify sovereignty, then disable for privacy
MAIA_INCLUDE_PROVIDER_META=0

# ─────────────────────────────────────────────────────────────────────────────────
# IDENTITY SECURITY (CRITICAL - DO NOT CHANGE IN PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────────
# These MUST remain unset or 0 in production - they trust client-supplied IDs
# MAIA_DEV_TRUST_BODY_ID=0     # NEVER set to 1 in production
# MAIA_TRUST_BODY_ID_IN_PROD=0 # NEVER set to 1 (production override bypass)
# MAIA_SELFLET_ALLOW_ANON=0    # NEVER set to 1 (allows anonymous writes)

# ─────────────────────────────────────────────────────────────────────────────────
# STRIPE PAYMENTS (Sustaining Circle)
# ─────────────────────────────────────────────────────────────────────────────────
# Get from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# Webhook signing secret (from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Product/Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_GUARDIAN=$15/month subscription price ID
STRIPE_PRICE_ELDER=$33/month subscription price ID
STRIPE_PRICE_FOUNDER=$222 one-time price ID

# ─────────────────────────────────────────────────────────────────────────────────
# RLM (RECURSIVE LANGUAGE MODELS)
# ─────────────────────────────────────────────────────────────────────────────────
# MIT OASYS paradigm for corpus-as-environment processing
# Internal Docker network URL (no change needed unless custom setup)
RLM_SERVICE_URL=http://rlm:8080
# Model for RLM recursive calls (uses ANTHROPIC_API_KEY)
RLM_MODEL=claude-sonnet-4-20250514

# ─────────────────────────────────────────────────────────────────────────────────
# BUILD MONITORING & DEVELOPER ALERTS
# ─────────────────────────────────────────────────────────────────────────────────
# App version for update detection (bumped on releases)
APP_VERSION=1.0.0

# Internal token for build alert API (generate with: openssl rand -hex 32)
INTERNAL_ALERT_TOKEN=GENERATE_WITH_openssl_rand_hex_32

# Developer key for accessing /api/build/status (generate with: openssl rand -hex 16)
DEV_STATUS_KEY=GENERATE_WITH_openssl_rand_hex_16

# Developer contact info
DEV_EMAIL=your@email.com

# ─────────────────────────────────────────────────────────────────────────────────
# NOTIFICATIONS (Optional - enable channels as needed)
# ─────────────────────────────────────────────────────────────────────────────────
# Email alerts via Resend (get key from resend.com)
RESEND_API_KEY=re_REPLACE_ME

# SMS for critical alerts (from twilio.com)
# TWILIO_ACCOUNT_SID=AC_REPLACE_ME
# TWILIO_AUTH_TOKEN=REPLACE_ME
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# DEV_PHONE=+1XXXXXXXXXX

# Slack webhook (from Slack App > Incoming Webhooks)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Telegram bot (from @BotFather)
# TELEGRAM_BOT_TOKEN=REPLACE_ME
# TELEGRAM_CHAT_ID=REPLACE_ME

# ─────────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# ─────────────────────────────────────────────────────────────────────────────────
# COMMS CREDENTIAL ENCRYPTION (AES-256-GCM)
# ─────────────────────────────────────────────────────────────────────────────────
# REQUIRED: Encrypts provider API keys (Resend, Twilio) at rest
# Generate with: openssl rand -hex 32
COMMS_ENCRYPTION_KEY=REPLACE_ME_64_HEX_CHARS
# Generate with: openssl rand -hex 16
COMMS_ENCRYPTION_SALT=REPLACE_ME_32_HEX_CHARS
