# Caddy block for {{SLUG}}.soullab.life
# Generated by: maia new-client {{SLUG}}
# Add this to your Caddyfile

{{DOMAIN}} {
    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        X-Stellium-Portal "{{SLUG}}"
        -Server
    }

    # Compression
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/{{SLUG}}.log {
            roll_size 10mb
            roll_keep 5
        }
    }

    # Reverse proxy to app
    # Option 1: Portal route (Next.js multi-tenant)
    # rewrite * /portal/{{SLUG}}{uri}
    # reverse_proxy maia:3000

    # Option 2: Dedicated container
    # reverse_proxy {{SLUG}}:3000

    # Option 3: Astro SSR (like oldhead)
    # reverse_proxy {{SLUG}}:4321

    # Uncomment and configure the appropriate option above
}
