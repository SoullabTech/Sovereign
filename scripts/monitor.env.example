# MAIA Monitor Configuration
# Copy to scripts/.env.monitor and fill in values.
# The monitor script loads this file automatically — no npm install needed.

# ── What to monitor ──────────────────────────────────────────────────────────

CHECK_URL=https://soullab.life/api/health
CHECK_INTERVAL_MS=300000
CHECK_TIMEOUT_MS=15000

# ── Monitor identity (appears in every alert) ─────────────────────────────────
# Set to "CTO Monitor", "Mac Studio Monitor", etc.

MONITOR_SOURCE=CTO Monitor

# ── Alert threshold ───────────────────────────────────────────────────────────
# Number of consecutive failures before sending a DOWN alert.
# 1 = alert immediately on first failure
# 2 = require two consecutive failures (~10 min at 5-min interval)

FAILURES_BEFORE_ALERT=1

# ── SMS via Twilio ────────────────────────────────────────────────────────────
# Use the Soullab Twilio account credentials (shared with the main app).

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1xxxxxxxxxx

# Comma-separated — both Kelly and CTO should receive all alerts
ALERT_PHONES=+1KELLY_NUMBER,+1CTO_NUMBER

# ── Email via Resend ──────────────────────────────────────────────────────────

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=monitor@soullab.life

# Comma-separated
ALERT_EMAILS=kelly@soullab.life,cto@example.com
