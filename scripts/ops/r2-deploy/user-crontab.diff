+30 2 * * * cd /home/soullab/MAIA-SOVEREIGN && PATH=/usr/bin:/usr/local/bin:/usr/bin:/bin bash scripts/backup-postgres.sh >> /home/soullab/MAIA-SOVEREIGN/database/backups/backup.log 2>&1
