# ═══════════════════════════════════════════════════════════════════════════════
# Witness stack environment — SAMPLE
# ═══════════════════════════════════════════════════════════════════════════════
#   cp scripts/witness/.env.witness.sample scripts/witness/.env.witness
#
# The real .env.witness is gitignored. Guard G6 refuses any DATABASE_URL that
# names a production database or host; guard G7 refuses any production hostname
# anywhere in this file. Both refusals are mechanical — a mistake here stops the
# run, it does not reach production.
#
# Keep this file boring. A witness stack needs enough to boot and be exercised;
# it does not need production credentials, and must never be given them.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database: the throwaway witness DB, reachable only inside the witness network
DATABASE_URL=postgresql://witness:witness@maia-witness-postgres:5432/maia_witness
WITNESS_PG_PASSWORD=witness

# ── App
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# WebAuthn / cookie domain: loopback only. Never a production hostname —
# guard G7 refuses this file if one appears anywhere in it.
WEBAUTHN_RP_ID=localhost
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3999

# ── Model access
# Supply a key only if the lane under witness actually needs model calls. A
# capture-lifecycle or turn-grammar witness usually does not.
ANTHROPIC_API_KEY=

# ── Voice
# V1 provisions no whisper/TTS sidecars: the Desktop launcher is not in V1, so
# nothing yet drives them. Leave unset unless the lane under witness needs them,
# and add the service to docker-compose.witness.yml deliberately when it does.
# WHISPER_LOCAL_URL=http://maia-witness-whisper:8000

# ── Posture
# A witness stack observes; it does not accumulate. Keep write-side features off
# unless the lane under witness is specifically about them.
MAIA_STRICT_503=1
MAIA_SELFLET_WRITE_ENABLED=0
MAIA_SELFLET_ALLOW_ANON=0
AIN_SHAPE_TELEMETRY=0
