+-- D21 REVIEW ADDENDUM: SQL-LOCAL AUTHOR-CONTEXT GUARD (never a release ACK).
+-- A direct FK proves that a row exists, NOT who authored it, whether its
+-- membership declaration remains current, or whether the referenced revision
+-- belongs to the same manuscript. This guard runs in the publisher transaction
+-- AFTER the author's five canonical rows have been inserted/verified.
+-- In particular: `living_work_id` must be author-selected, not inferred from
+-- the manuscript ID; a manuscript may lawfully declare more than one Work.
+-- The v2 Source original and encrypted projections need external R20 + complete
+-- vault/PG commit proof BEFORE the member sees a successful import.
+CREATE FUNCTION writer_source_v2_pending_author_context_guard()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  PERFORM 1
+    FROM writer_source_v2_import_intents i
+    JOIN writer_source_v2_completed_originals o
+      ON o.arrival_id = i.arrival_id AND o.object_id = i.object_id
+    JOIN living_works w ON w.id = NEW.living_work_id
+    JOIN member_manuscripts m ON m.id = NEW.manuscript_id
+    JOIN living_work_expressions e ON e.id = NEW.declaration_id
+    JOIN manuscript_working_drafts d ON d.id = NEW.draft_id
+    JOIN working_draft_revisions r ON r.id = NEW.first_revision_id
+   WHERE i.arrival_id = NEW.arrival_id
+     AND i.member_id = NEW.member_id
+     AND i.living_work_id = NEW.living_work_id
+     AND i.manuscript_id = NEW.manuscript_id
+     AND w.member_id = NEW.member_id
+     AND m.member_id = NEW.member_id
+     AND e.living_work_id = NEW.living_work_id
+     AND e.expression_type = 'manuscript'
+     AND e.expression_id = NEW.manuscript_id
+     AND e.declared_by = NEW.member_id
+     AND d.manuscript_id = NEW.manuscript_id
+     AND d.member_id = NEW.member_id
+     AND r.draft_id = NEW.draft_id
+     AND r.revision_number = 1
+     AND r.saved_by = NEW.member_id;
+  IF NOT FOUND THEN
+    RAISE EXCEPTION 'writer_source_v2_author_context_unverified'
+      USING ERRCODE = '23514';
+  END IF;
+  RETURN NEW;
+END $$;
+CREATE TRIGGER writer_source_v2_pending_context_insert
+  BEFORE INSERT ON writer_source_v2_pending_publications
+  FOR EACH ROW EXECUTE FUNCTION writer_source_v2_pending_author_context_guard();
 
