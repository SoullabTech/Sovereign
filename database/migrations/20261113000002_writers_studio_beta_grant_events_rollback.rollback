-- Rollback for writers_studio_beta_grant_events.
-- Safe only while WS_BETA_GRANT_MODE is 'legacy' (nothing reads the table). If grants have been issued, export the rows
-- first: they are the audit record of who was given beta access, by whom, and until when.
BEGIN;
DROP TRIGGER IF EXISTS writers_studio_beta_grant_events_no_truncate ON writers_studio_beta_grant_events;
DROP TRIGGER IF EXISTS writers_studio_beta_grant_events_guard ON writers_studio_beta_grant_events;
DROP INDEX IF EXISTS idx_writers_studio_beta_grant_events_member_latest;
DROP TABLE IF EXISTS writers_studio_beta_grant_events;
DROP FUNCTION IF EXISTS writers_studio_beta_grant_events_no_truncate();
DROP FUNCTION IF EXISTS writers_studio_beta_grant_events_guard();
COMMIT;
