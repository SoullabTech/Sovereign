-- Rollback for writers_studio_maia_usage.
-- Safe at any time: the table holds only usage counts (no content), nothing reads it in M1, and nothing is refused
-- because of it. Dropping it loses the shadow measurements the founder needs to set the Free and Pro amounts.
BEGIN;
DROP INDEX IF EXISTS idx_writers_studio_maia_usage_member_time;
DROP TABLE IF EXISTS writers_studio_maia_usage;
COMMIT;
