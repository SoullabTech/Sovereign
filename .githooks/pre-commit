#!/usr/bin/env bash
# THIS IS THE HOOK THAT RUNS. scripts/setup-githooks.sh installs this file
# verbatim (cp), exactly as it does for .githooks/pre-push — so there is one
# copy to maintain and it cannot drift from the installed hook.
#
# Only GREEN checks belong here. A commit gate that cannot fail, or one that is
# red on pre-existing debt, is a false control surface — see
# docs/ops/PRECOMMIT_RECONCILIATION_2026-08-09.md for the checks deliberately
# NOT bound here and what each is waiting on.
#
# Branch allowlist source of truth: scripts/check-branch-allowed.sh (shared with pre-push).
set -euo pipefail
echo "🔒 Sovereignty pre-commit check..."

# Branch guard — only commit on approved branches.
BRANCH="$(git branch --show-current)"
scripts/check-branch-allowed.sh COMMIT "$BRANCH"
echo "✅ Branch guard: committing to '$BRANCH' (allowed)"

export GIT_PRE_COMMIT=1

# Supabase ban (docs/canon — local PostgreSQL only)
npm run check:no-supabase

# Provider governance — no NEW OpenAI surfaces (docs/canon/PROVIDER_GOVERNANCE.md)
npm run check:no-openai

# No direct @anthropic-ai/sdk imports outside allowlist — route via sovereignRouter.
# (Green as of 2026-08-09: 1 approved, 1 operational, 55 grandfathered. ~2s.)
npm run check:no-direct-anthropic

# PHI / sensitive logging gate — same canonical scanner CI runs (sovereignty-gate.yml,
# step "PHI / sensitive logging gate") and the SAME context branch protection requires
# on clean-main-no-secrets. This is early local feedback only — CI + the required
# `sovereignty` context remain the authoritative enforcement boundary; bypassing this
# hook (--no-verify) does not bypass that. docs/ops/PHI_GATE_REPAIR_2026-08-09.md.
npm run check:phi-gate

# Design canon — member-facing UI needs an Experience Contract.
# Green by construction because it is a RATCHET: GIT_PRE_COMMIT=1 scopes it to
# STAGED files only, so it asks nothing of the ~1,400 pre-existing surfaces.
# You pay only for the room you actually touch. docs/design/contracts/README.md
npm run check:design-canon

echo "✅ Pre-commit checks passed"
