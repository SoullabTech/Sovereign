#!/usr/bin/env bash
# ⚠️⚠️ NOT the hook that runs under the supported setup — but NOT inert either.
#
# Two installers exist and produce DIFFERENT gates:
#
#   scripts/setup-githooks.sh   (CORRECT)  writes its own body into
#       $(git rev-parse --git-common-dir)/hooks — this file is ignored.
#       Runs: branch guard, check:no-supabase, check:no-openai.
#
#   scripts/dev/setup-hooks.sh  (DO NOT RUN) sets core.hooksPath .githooks,
#       which makes THIS FILE the live gate.
#       Runs: branch guard, check:no-supabase, check:no-inline-names,
#             check:no-phi-enc, check:phi-inventory, check:no-direct-anthropic.
#
# Neither list is a superset of the other. check:no-openai runs only under the
# correct installer; the PHI/inline-name checks only under the other. And
# check:no-direct-anthropic is knowingly RED (setup-githooks.sh omits it on
# purpose), so activating this file can block every commit.
#
# This divergence is RECORDED, NOT RESOLVED — unifying the two gates would
# broaden enforcement, which was explicitly out of scope for the correction
# that documented it. See docs/ops/VERIFICATION_SURFACE_TRUTH_2026-08-06.md.
#
# Branch allowlist source of truth is scripts/check-branch-allowed.sh.
set -euo pipefail

echo "🔒 Sovereignty pre-commit check..."

# Branch guard — allowlist shared with pre-push via scripts/check-branch-allowed.sh
scripts/check-branch-allowed.sh COMMIT "$(git branch --show-current)"

# 1. No Supabase
npm run check:no-supabase
SUPABASE_EXIT=$?

# 2. No inline name logic (preferred_name || name drift)
npm run check:no-inline-names
NAMES_EXIT=$?

# 3. No PHI encryption columns in responses
npm run check:no-phi-enc
PHI_EXIT=$?

# 4. PHI columns inventory check
npm run check:phi-inventory
INVENTORY_EXIT=$?

# 5. No direct @anthropic-ai/sdk imports outside allowlist
#    (drift prevention — see docs/orientation/maia-sovereign-runtime-intelligence-audit.md)
npm run check:no-direct-anthropic
ANTHROPIC_EXIT=$?

if [ $SUPABASE_EXIT -eq 0 ] && [ $NAMES_EXIT -eq 0 ] && [ $PHI_EXIT -eq 0 ] && [ $INVENTORY_EXIT -eq 0 ] && [ $ANTHROPIC_EXIT -eq 0 ]; then
  echo "✅ Sovereignty check passed"
  exit 0
else
  echo "❌ Sovereignty check failed - commit blocked"
  if [ $SUPABASE_EXIT -ne 0 ]; then
    echo "   - Supabase violations found"
  fi
  if [ $NAMES_EXIT -ne 0 ]; then
    echo "   - Inline name logic found (use resolveClientDisplayName/resolveMemberDisplayName)"
  fi
  if [ $PHI_EXIT -ne 0 ]; then
    echo "   - PHI encryption leak risks found"
  fi
  if [ $INVENTORY_EXIT -ne 0 ]; then
    echo "   - PHI inventory inconsistent"
  fi
  if [ $ANTHROPIC_EXIT -ne 0 ]; then
    echo "   - Direct @anthropic-ai/sdk imports outside allowlist (route through sovereignRouter)"
  fi
  exit 1
fi
