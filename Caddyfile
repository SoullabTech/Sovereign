# ═══════════════════════════════════════════════════════════════════════════════
# Nostr Relay — wss://nostr.soullab.life
# ═══════════════════════════════════════════════════════════════════════════════
# WebSocket gateway to the self-hosted strfry relay (maia-nostr-relay:7777).
# TLS terminated here by Caddy; backend uses plain WebSocket over Docker network.
nostr.soullab.life {
    import deny_disabled_routes
    @ws {
        header Connection *Upgrade*
        header Upgrade        websocket
    }
    handle @ws {
        reverse_proxy maia-nostr-relay:7777 {
            header_up Host      {host}
            header_up X-Real-IP {remote_host}
            # Disable buffering for persistent WebSocket connections
            flush_interval -1
        }
    }
    # HTTP fallback (NIP-11 relay info endpoint)
    handle {
        reverse_proxy maia-nostr-relay:7777 {
            header_up Host      {host}
            header_up X-Real-IP {remote_host}
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "no-referrer"
        -Server
    }

    log {
        output file /var/log/caddy/nostr-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# ═══════════════════════════════════════════════════════════════════════════════
# LiveKit signaling — wss://livekit.soullab.life   (Session Room Phase 3, PR2)
# ═══════════════════════════════════════════════════════════════════════════════
# WebSocket signaling gateway to the self-hosted LiveKit SFU (livekit:7880). TLS terminated here
# by Caddy (our own host). MEDIA does NOT flow through Caddy — it uses the dedicated TURN listener
# (3478, router-forwarded), per Decision #1. The Twirp room-management API (/twirp/*) is BLOCKED
# publicly here — it is reachable only from the internal Docker network (the maia app), never the
# public internet (defense in depth; design §6.1 C2b). DNS: add livekit.soullab.life -> public IP.
livekit.soullab.life {
    import deny_disabled_routes
    # ALLOWLIST (default-deny): only the WebSocket signaling upgrade is proxied. Everything else on
    # 7880 — the Twirp management API, /rtc/validate, etc. — is blocked publicly (the room-mgmt API
    # is reachable only from the internal Docker network, by the maia app). Media never flows
    # through Caddy; it uses the dedicated TURN listener (3478). If the client SDK turns out to need
    # a narrow HTTP preflight (e.g. /rtc/validate), add THAT path explicitly at the room-proof gate.
    @ws {
        header Connection *Upgrade*
        header Upgrade        websocket
    }
    handle @ws {
        reverse_proxy livekit:7880 {
            header_up Host      {host}
            header_up X-Real-IP {remote_host}
            flush_interval -1   # no buffering for the persistent signaling WebSocket
        }
    }
    # Default-deny everything that is not the signaling WebSocket.
    handle {
        respond 403
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "no-referrer"
        -Server
    }

    log {
        output file /var/log/caddy/livekit-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# Health check endpoint for load balancers
:8080 {
    import deny_disabled_routes
    respond /health 200
}
