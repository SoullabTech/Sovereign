# Master Fields - Subdomain routing for individual master field sites
# Middleware rewrites jondi.soullab.life/* → /fields/jondi/*
# ═══════════════════════════════════════════════════════════════════════════════
jondi.soullab.life {
    import deny_disabled_routes
    reverse_proxy maia-sovereign:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    header {
        X-MAIA-Origin "caddy-sovereign-field"
        X-Field-Slug "jondi"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/jondi-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

