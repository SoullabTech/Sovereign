# Jeremy Larson's Business Site (Palisades Master Handyman)
# jlmasterhandyman.com is canonical; jeremy.soullab.life redirects to it
# ═══════════════════════════════════════════════════════════════════════════════
jlmasterhandyman.com, www.jlmasterhandyman.com {
    # Canonical: reverse-proxy the Palisades Handyman container.
    reverse_proxy palisades-handyman:4321 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/palisades-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

jeremy.soullab.life {
    import deny_disabled_routes
    redir https://jlmasterhandyman.com{uri} permanent
}

# ═══════════════════════════════════════════════════════════════════════════════
# MAIA API Service - Multi-tenant Backend
# ═══════════════════════════════════════════════════════════════════════════════
# All API requests from frontends route here.
# MAIA API is the backbone for all Soullab products.
api.soullab.life {
    import deny_disabled_routes
    # Reverse proxy to MAIA API container
    reverse_proxy maia-api:3001 {
        # Health checks
        health_uri /v1/health
        health_interval 30s
        health_timeout 5s

        # Headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # CORS headers handled by API, but add security headers
    header {
        X-MAIA-Origin "caddy-sovereign-api"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/api-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

