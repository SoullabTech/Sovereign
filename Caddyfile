# ═══════════════════════════════════════════════════════════════════════════════
# Loralee Starweaver - Stellium Astrology Portal
# ═══════════════════════════════════════════════════════════════════════════════
loralee.soullab.life {
    # Rewrite all paths to portal namespace
    # loralee.soullab.life/admin → /portal/loralee/admin
    # loralee.soullab.life/services → /portal/loralee/services
    rewrite * /portal/loralee{uri}

    # Reverse proxy to MAIA container
    reverse_proxy maia:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        X-MAIA-Origin "caddy-sovereign-portal"
        X-Stellium-Portal "loralee"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/loralee-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

