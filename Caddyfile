# ═══════════════════════════════════════════════════════════════════════════════
# MAIA Sovereign - Caddy Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Automatic HTTPS via Let's Encrypt
# Replace {$DOMAIN} with your actual domain, or set DOMAIN env var
# ═══════════════════════════════════════════════════════════════════════════════

# Local development - no TLS
:80 {
    @streaming {
        path /api/voice/stream-conversation
        path /api/*/stream*
    }
    handle @streaming {
        reverse_proxy maia:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
        }
    }

    reverse_proxy maia:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-MAIA-Origin "caddy-sovereign"
    }

    encode gzip zstd
}

# Redirect www to apex (prevents WebAuthn ORIGIN_MISMATCH)
www.soullab.life {
    redir https://soullab.life{uri} permanent
}

# Redirect maia subdomain to apex
maia.soullab.life {
    redir https://soullab.life{uri} permanent
}

soullab.life {
    # ═══════════════════════════════════════════════════════════════════════════
    # CORS for API requests (iOS/Capacitor app support)
    # Allows requests from capacitor://localhost, ionic://localhost, etc.
    # ═══════════════════════════════════════════════════════════════════════════

    # CORS: Capacitor/iOS origins
    @capacitor_origin {
        header Origin capacitor://localhost
    }
    @ionic_origin {
        header Origin ionic://localhost
    }
    @localhost_origin {
        header Origin http://localhost*
    }

    # Handle CORS preflight (OPTIONS) requests for API
    @cors_preflight {
        method OPTIONS
        path /api/*
    }
    handle @cors_preflight {
        # Capacitor origin
        @preflight_capacitor {
            header Origin capacitor://localhost
        }
        header @preflight_capacitor {
            Access-Control-Allow-Origin "capacitor://localhost"
            Access-Control-Allow-Credentials "true"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-User-ID, X-Request-ID, X-Member-Id, X-Maia-Tier, X-Maia-Roles"
            Access-Control-Max-Age "86400"
        }
        # Ionic origin
        @preflight_ionic {
            header Origin ionic://localhost
        }
        header @preflight_ionic {
            Access-Control-Allow-Origin "ionic://localhost"
            Access-Control-Allow-Credentials "true"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-User-ID, X-Request-ID, X-Member-Id, X-Maia-Tier, X-Maia-Roles"
            Access-Control-Max-Age "86400"
        }
        # Localhost origin (dev)
        @preflight_localhost {
            header_regexp Origin ^http://localhost
        }
        header @preflight_localhost {
            Access-Control-Allow-Origin "{header.Origin}"
            Access-Control-Allow-Credentials "true"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-User-ID, X-Request-ID, X-Member-Id, X-Maia-Tier, X-Maia-Roles"
            Access-Control-Max-Age "86400"
        }
        # Null origin (WebKit edge case - some Capacitor/WKWebView contexts)
        @preflight_null {
            header Origin null
        }
        header @preflight_null {
            Access-Control-Allow-Origin "null"
            Access-Control-Allow-Credentials "true"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-User-ID, X-Request-ID, X-Member-Id, X-Maia-Tier, X-Maia-Roles"
            Access-Control-Max-Age "86400"
        }
        respond "" 204
    }

    # SSE/Streaming endpoints - disable compression and buffering
    # NOTE: CORS headers are handled by Next.js API routes
    @streaming {
        path /api/voice/stream-conversation
        path /api/*/stream*
    }
    handle @streaming {
        reverse_proxy maia:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            # Disable buffering for streaming responses
            flush_interval -1
        }
    }

    # API requests (non-streaming)
    # Add CORS headers for Capacitor/mobile app responses
    @api {
        path /api/*
    }
    handle @api {
        reverse_proxy maia:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
        # Add CORS headers to responses for mobile origins
        @api_capacitor {
            header Origin capacitor://localhost
        }
        header @api_capacitor {
            Access-Control-Allow-Origin "capacitor://localhost"
            Access-Control-Allow-Credentials "true"
        }
        @api_ionic {
            header Origin ionic://localhost
        }
        header @api_ionic {
            Access-Control-Allow-Origin "ionic://localhost"
            Access-Control-Allow-Credentials "true"
        }
        @api_null {
            header Origin null
        }
        header @api_null {
            Access-Control-Allow-Origin "null"
            Access-Control-Allow-Credentials "true"
        }
    }

    # Regular reverse proxy for non-API requests
    reverse_proxy maia:3000 {
        # Health checks
        health_uri /api/consciousness/health
        health_interval 30s
        health_timeout 5s

        # Headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers + origin marker
    header {
        # Origin marker (proves request came from sovereign origin)
        X-MAIA-Origin "caddy-sovereign"
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # XSS protection
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        # Remove server header
        -Server
    }

    # Compression (exclude SSE which is handled above)
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

