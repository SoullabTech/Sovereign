# ═══════════════════════════════════════════════════════════════════════════════
# MAIA Sovereign - Caddy Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Automatic HTTPS via Let's Encrypt
# Replace {$DOMAIN} with your actual domain, or set DOMAIN env var
# ═══════════════════════════════════════════════════════════════════════════════

# Local development - no TLS
:80 {
    @streaming {
        path /api/voice/stream-conversation
        path /api/*/stream*
    }
    handle @streaming {
        reverse_proxy maia:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
        }
    }

    reverse_proxy maia:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-MAIA-Origin "caddy-sovereign"
    }

    encode gzip zstd
}

soullab.life, www.soullab.life {
    # SSE/Streaming endpoints - disable compression and buffering
    @streaming {
        path /api/voice/stream-conversation
        path /api/*/stream*
    }
    handle @streaming {
        reverse_proxy maia:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            # Disable buffering for streaming responses
            flush_interval -1
        }
    }

    # Regular reverse proxy for all other requests
    reverse_proxy maia:3000 {
        # Health checks
        health_uri /api/consciousness/health
        health_interval 30s
        health_timeout 5s

        # Headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers + origin marker
    header {
        # Origin marker (proves request came from sovereign origin)
        X-MAIA-Origin "caddy-sovereign"
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        # XSS protection
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        # Remove server header
        -Server
    }

    # Compression (exclude SSE which is handled above)
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

