# Old Head Plaster - Astro SSR with Virtual Daragh
# ═══════════════════════════════════════════════════════════════════════════════
oldhead.soullab.life {
    # Reverse proxy to OldHead Astro container
    reverse_proxy oldhead:4321 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/oldhead-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

# ═══════════════════════════════════════════════════════════════════════════════
# Chart Subdomain - Birth Chart Calculator Funnel
# ═══════════════════════════════════════════════════════════════════════════════
chart.soullab.life {
    # Rewrite root to /chart page
    rewrite / /chart

    # Reverse proxy to MAIA container
    reverse_proxy maia:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        X-MAIA-Origin "caddy-sovereign-chart"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/chart-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

