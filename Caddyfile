# ═══════════════════════════════════════════════════════════════════════════════
# MAIA Sovereign - Caddy Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Automatic HTTPS via Let's Encrypt
# Replace {$DOMAIN} with your actual domain, or set DOMAIN env var
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# EDGE-EMERGENCY-01 — TEMPORARY CONTAINMENT, NOT A FIX
# ═══════════════════════════════════════════════════════════════════════════════
# Four routes derive cross-account authority from request-controlled input with
# no session resolution. Each deny below is a COMPENSATING CONTROL for a defect
# that still exists in the application. None of them repairs anything.
#
# This snippet previously existed only as an uncommitted modification on the
# production host. A `git stash push` at 2026-08-25 16:37:17Z removed it from the
# working tree; the Caddy container restarted at 2026-08-25T18:38:38Z and loaded
# canonical without it. The four surfaces below were therefore unprotected from
# that instant until this patch is deployed. The bytes were recovered from
# stash@{0} under EDGE-SECURITY-CUSTODY-01 (sha 35bbd769…, 37,396 B) — that
# incident is why this now lives in canonical source instead of on one host.
#
# REMOVAL CONTRACT — per deny, never all-or-nothing. A deny may be retired only
# when its own AUTH-BOUNDARY-04 repair has passed AND a direct hostile request,
# with this deny inactive for that route, is rejected by the APPLICATION.
# Removing one on the strength of a source-side change alone is not permitted.
(deny_disabled_routes) {
    # 04A · /api/members/migrate-data — accepts caller-chosen SOURCE and
    # DESTINATION member ids with no session resolution, and has no ACCESS_RULES
    # entry, so the Mode A unmapped-route default lets it through middleware.
    # An unauthenticated cross-account data-transfer primitive.
    # Denying it BREAKS server-to-server onboarding linkage from
    # /api/members/register-local — an accepted, deliberate consequence.
    # RETIRE WHEN: 04A proves a verified caller, authorized for BOTH source and
    # destination, is required.
    @disabled_routes path /api/members/migrate-data /api/members/migrate-data/
    handle @disabled_routes {
        respond "Endpoint disabled" 403 {
            close
        }
    }

    # 04C · /api/stellium/clients/* DELETE — authorizes on a caller-supplied
    # ?practitionerId= with no session resolution, then permanently deletes a
    # client record belonging to a practitioner (third-party PII; 13 rows in
    # production). No in-repo UI invokes deletion, so denying it disrupts no live
    # workflow. Reads are unaffected.
    # RETIRE WHEN: 04C proves a verified practitioner plus a real
    # practitioner↔client relationship is required. The request may name the
    # target client; it may never name the practitioner.
    @stellium_client_delete {
        path /api/stellium/clients/*
        method DELETE
    }
    handle @stellium_client_delete {
        respond "Endpoint disabled" 403 {
            close
        }
    }

    # 04D · /api/commons/contributions mutations — authorize on a caller-supplied
    # memberId/curatorId rather than a verified session actor; PUT/DELETE compare
    # `created_by !== memberId` where memberId comes from the body or query. The
    # family is unpopulated (commons_contributions = 0 rows), so denying mutation
    # disrupts no live use — but the first contribution would be vulnerable with
    # no new deployment. Reads stay open; the public browse surface is unaffected.
    # RETIRE WHEN: 04D proves route-level authorization independently. The matrix
    # rules on this path pair minTier with rolesAnyOf, which AUTH-MATRIX-01 shows
    # can short-circuit through the insufficient-tier bypass — so fixing the
    # matrix alone is NOT sufficient evidence.
    @commons_mutation {
        path /api/commons/contributions /api/commons/contributions/*
        method POST PUT PATCH DELETE
    }
    handle @commons_mutation {
        respond "Endpoint disabled" 403 {
            close
        }
    }

    # 04B · /api/conversations/export — takes the subject identity from caller
    # input (?userId= on GET, body.userId on POST) and queries on it directly,
    # with no session resolution and no middleware gate. Any caller could name any
    # member. It is currently non-disclosing ONLY because it reads
    # `conversation_messages`, a table absent from production, so it 500s — that
    # is accidental non-functionality, not a boundary, and it does leak internal
    # schema error text in `details`. Repointing it at the live store
    # (conversation_turns, 39,956 rows) would make it an unauthenticated
    # cross-member conversation dump with no control removed.
    # RETIRE WHEN: 04B proves a verified caller exporting their OWN conversations,
    # or a separately authorized export contract. Do NOT retire on the strength of
    # the route being deleted in source — the deployed artifact must independently
    # prove it absent.
    @conversations_export path /api/conversations/export /api/conversations/export/
    handle @conversations_export {
        respond "Endpoint disabled" 403 {
            close
        }
    }
}

# Local development - no TLS
:80 {
    import deny_disabled_routes
    @streaming {
        path /api/voice/stream-conversation
        path /api/*/stream*
    }
    handle @streaming {
        reverse_proxy maia-sovereign:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
        }
    }

    reverse_proxy maia-sovereign:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-MAIA-Origin "caddy-sovereign"
    }

    encode gzip zstd
}

# Redirect www to apex (prevents WebAuthn ORIGIN_MISMATCH)
www.soullab.life {
    import deny_disabled_routes
    redir https://soullab.life{uri} permanent
}

# MAIA application
maia.soullab.life {
    import deny_disabled_routes
    reverse_proxy maia-sovereign:3000
}

soullab.life {
    import deny_disabled_routes
    # ═══════════════════════════════════════════════════════════════════════════
    # CORS for API requests (iOS/Capacitor app support)
    # Allows requests from capacitor://localhost, ionic://localhost, etc.
    # ═══════════════════════════════════════════════════════════════════════════

    # CORS: Capacitor/iOS origins
    @capacitor_origin {
        header Origin capacitor://localhost
    }
    @ionic_origin {
        header Origin ionic://localhost
    }
    @localhost_origin {
        header Origin http://localhost*
    }

    # Handle CORS preflight (OPTIONS) requests for API
    @cors_preflight {
        method OPTIONS
        path /api/*
    }
    handle @cors_preflight {
        # Capacitor origin
        @preflight_capacitor {
            header Origin capacitor://localhost
        }
        header @preflight_capacitor {
            Access-Control-Allow-Origin "capacitor://localhost"
            Access-Control-Allow-Credentials "true"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-User-ID, X-Request-ID, X-Member-Id, X-Maia-Tier, X-Maia-Roles"
            Access-Control-Max-Age "86400"
        }
        # Ionic origin
        @preflight_ionic {
            header Origin ionic://localhost
        }
        header @preflight_ionic {
            Access-Control-Allow-Origin "ionic://localhost"
            Access-Control-Allow-Credentials "true"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-User-ID, X-Request-ID, X-Member-Id, X-Maia-Tier, X-Maia-Roles"
            Access-Control-Max-Age "86400"
        }
        # Localhost origin (dev)
        @preflight_localhost {
            header_regexp Origin ^http://localhost
        }
        header @preflight_localhost {
            Access-Control-Allow-Origin "{header.Origin}"
            Access-Control-Allow-Credentials "true"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-User-ID, X-Request-ID, X-Member-Id, X-Maia-Tier, X-Maia-Roles"
            Access-Control-Max-Age "86400"
        }
        # Null origin (WebKit edge case - some Capacitor/WKWebView contexts)
        @preflight_null {
            header Origin null
        }
        header @preflight_null {
            Access-Control-Allow-Origin "null"
            Access-Control-Allow-Credentials "true"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-User-ID, X-Request-ID, X-Member-Id, X-Maia-Tier, X-Maia-Roles"
            Access-Control-Max-Age "86400"
        }
        respond "" 204
    }

    # ═══════════════════════════════════════════════════════════════════════════
    # Beta tester APK distribution (added 2026-05-18 for Tara's Pixel 8a + Samsung tablet round)
    # ───────────────────────────────────────────────────────────────────────────
    # Why this exists:
    #   Google Drive's preview path serves APK files with an inferred MIME based
    #   on a thumbnail render, not the .apk extension. On Samsung tablets in
    #   particular, Android's intent resolver then offers ONLY image apps to
    #   "open" the file (Gallery, Photos, Canva) instead of the package
    #   installer. Three consecutive tester rounds (rounds 6, 7, 8) failed on
    #   the tablet for this reason — never an app bug, always the delivery.
    #
    # What this does:
    #   - Serves /beta/**/*.apk directly from /srv/beta inside the container,
    #     bound to ./beta on the host.
    #   - Sets Content-Type: application/vnd.android.package-archive (the
    #     canonical APK MIME), bypassing every intermediate MIME-guessing layer.
    #   - Forces Content-Disposition: attachment so Android downloads rather
    #     than previews. Combined with the correct MIME, the bytes hit the
    #     package installer cleanly.
    #   - Cache-Control: no-store — same filename across rebuilds always
    #     serves fresh bytes; no stale-APK risk for testers.
    #
    # Must be declared BEFORE @html_pages, which would otherwise match /beta/*.
    # ═══════════════════════════════════════════════════════════════════════════
    @beta_apk {
        path_regexp ^/beta/.+\.apk$
    }
    handle @beta_apk {
        root * /srv
        header Content-Type "application/vnd.android.package-archive"
        header Content-Disposition "attachment"
        header Cache-Control "no-store"
        file_server
    }

    # SSE/Streaming endpoints - disable compression and buffering
    # NOTE: CORS headers are handled by Next.js API routes
    @streaming {
        path /api/voice/stream-conversation
        path /api/*/stream*
    }
    handle @streaming {
        reverse_proxy maia-sovereign:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            # Disable buffering for streaming responses
            flush_interval -1
        }
    }

    # API requests (non-streaming)
    # Add CORS headers for Capacitor/mobile app responses
    @api {
        path /api/*
    }
    handle @api {
        reverse_proxy maia-sovereign:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
        # Add CORS headers to responses for mobile origins
        @api_capacitor {
            header Origin capacitor://localhost
        }
        header @api_capacitor {
            Access-Control-Allow-Origin "capacitor://localhost"
            Access-Control-Allow-Credentials "true"
        }
        @api_ionic {
            header Origin ionic://localhost
        }
        header @api_ionic {
            Access-Control-Allow-Origin "ionic://localhost"
            Access-Control-Allow-Credentials "true"
        }
        @api_null {
            header Origin null
        }
        header @api_null {
            Access-Control-Allow-Origin "null"
            Access-Control-Allow-Credentials "true"
        }
    }

    # Hashed static assets — cache forever (immutable)
    @static_hashed {
        path /_next/static/*
    }
    handle @static_hashed {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy maia-sovereign:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # HTML pages — never cache, always get fresh chunk references
    @html_pages {
        not path /api/* /_next/* /icons/* /*.json /*.ico /*.png /*.svg /*.jpg /*.webp /*.woff2
    }
    handle @html_pages {
        header Cache-Control "no-cache, no-store, must-revalidate"
        reverse_proxy maia-sovereign:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Regular reverse proxy for remaining requests (favicon, etc.)
    reverse_proxy maia-sovereign:3000 {
        # Health checks
        health_uri /api/consciousness/health
        health_interval 30s
        health_timeout 5s

        # Headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers + origin marker
    header {
        # Origin marker (proves request came from sovereign origin)
        X-MAIA-Origin "caddy-sovereign"
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        # Referrer: send nothing cross-origin (privacy + SSRF reduction)
        Referrer-Policy "no-referrer"
        # Allow mic + camera on soullab.life (MAIA voice + Session Room recording)
        # Other features remain restricted. Geolocation stays denied — not used.
        Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
        # X-XSS-Protection intentionally omitted — deprecated, can amplify XSS in legacy IE
        # Remove server header
        -Server
    }

    # ── Admin route protection (Tailscale / VPN — enable when ready) ───────────
    # Uncomment to restrict /api/admin/* to Tailscale IPs (100.x.x.x) only.
    # Without Tailscale: replace with your static IP (home/office).
    #
    # @admin_path {
    #     path /api/admin/*
    # }
    # handle @admin_path {
    #     @not_tailscale {
    #         not remote_ip 100.64.0.0/10 127.0.0.1/32
    #     }
    #     respond @not_tailscale "Forbidden" 403
    #     reverse_proxy maia-sovereign:3000 {
    #         header_up Host {host}
    #         header_up X-Real-IP {remote_host}
    #         header_up X-Forwarded-For {remote_host}
    #         header_up X-Forwarded-Proto {scheme}
    #     }
    # }

    # Compression (exclude SSE which is handled above)
    encode gzip zstd

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

