# ═══════════════════════════════════════════════════════════════════════════════
# Loralee Starweaver - Stellium Astrology Portal
# ═══════════════════════════════════════════════════════════════════════════════
loralee.soullab.life {
    # Handle root path - rewrite to portal without trailing slash
    handle / {
        rewrite * /portal/loralee
        reverse_proxy maia:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Handle /portal/* paths directly (already correct path)
    handle /portal/* {
        reverse_proxy maia:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Handle all other page paths - rewrite to portal namespace
    # loralee.soullab.life/admin → /portal/loralee/admin
    # loralee.soullab.life/services → /portal/loralee/services
    @pages {
        not path /api/* /_next/* /icons/* /manifest.json /favicon.ico /*.png /*.svg /*.jpg /*.webp
    }
    handle @pages {
        rewrite * /portal/loralee{uri}
        reverse_proxy maia:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Fallback for static assets and API routes - pass through unchanged
    reverse_proxy maia:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        X-MAIA-Origin "caddy-sovereign-portal"
        X-Stellium-Portal "loralee"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/loralee-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}

