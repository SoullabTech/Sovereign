# MinisForum Environment Variables

# Cloudflare Tunnel Token (required for public access)
# Generate this from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=

# Domain configuration
DOMAIN=soullab.life

# Database configuration (if needed for local services)
DATABASE_URL=postgresql://soullab:password@postgres:5432/maia_consciousness

# API configuration
API_PORT=3001

# Service ports
JEREMY_PORT=3000
OLDHEAD_PORT=4321
LORALEE_PORT=3000
MARC_PORT=3000
RUDEBOY_PORT=4323

# Security settings
# Enable HTTPS (set to true for production)
ENABLE_HTTPS=true

# Logging
LOG_LEVEL=info

# Debug settings
DEBUG=false
# ─── Access authorities ──────────────────────────────────────────────────────
# Two SEPARATE allowlists of member UUIDs, comma-separated. Both fail closed:
# unset means nobody passes, never everybody.
#
# ⛔ Do not merge these. FOUNDER_MEMBER_IDS governs founder-PRIVATE surfaces —
# the /api/founder/* console (contacts, tasks, signals, rollout, content), Book
# Studio drafts, workbench uploads, the render pipeline. Adding someone there to
# get them into Lab Tools would hand them the founder's private correspondence
# and unpublished drafts as a side effect. That is why the second list exists
# (founder ruling 2026-09-04); see lib/access/labAccess.ts.
#
# A founder automatically has Lab Tools access and need not be listed twice.
# The union runs one way only: a lab member is NOT thereby a founder.

# The founder. Founder-private surfaces.
FOUNDER_MEMBER_IDS=

# Founding members. The internal laboratory (/labtools) and nothing else.
LAB_ACCESS_MEMBER_IDS=

# EARLY-FIELD-01 — the early Living Field instrument (LivingFieldInstrument)
# and NOTHING else: the Living Field itself stays open to every member.
# A third, separate authority: founders and lab members are NOT admitted
# implicitly — list everyone explicitly. See lib/access/earlyFieldAccess.ts.
#
# EARLY_FIELD_ENABLED must be exactly "true" to open the cohort; anything else
# (unset, "false", "TRUE", "1") is closed. Rollback = set false + restart.
# One malformed id in the list closes the cohort for everyone.
EARLY_FIELD_ENABLED=false
EARLY_FIELD_MEMBER_IDS=

# HOUSE-STUDIO H1 — controlled exposure of explicit Work-context arrival only.
# Writer's Studio itself stays universal. This authority is separate from
# EARLY_FIELD_* and every lab/founder entitlement.
#
# HOUSE_STUDIO_H1_ENABLED must be exactly "true" to open the cohort. Any other
# value is closed. One malformed member id closes the whole cohort.
HOUSE_STUDIO_H1_ENABLED=false
HOUSE_STUDIO_H1_MEMBER_IDS=

# Dedicated HMAC secret for practitioner client-portal sessions. Required; do not reuse PHI_ENCRYPTION_KEY.
CLIENT_SESSION_SECRET=

# ─── Independent human safety delivery ───────────────────────────────────────
# At least one of the two independent channels below must be configured before
# S1-S3 or E2 can be closed. These channels are deliberately independent of
# Resend so a mail outage cannot silence member-safety or uptime alerts.
#
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SAFETY_ALERT_PHONE=
#
# Slack webhook
SAFETY_ALERT_SLACK_WEBHOOK_URL=
#
# Never put member message content in these alert transports.
