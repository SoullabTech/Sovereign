# MinisForum Environment Variables

# Cloudflare Tunnel Token (required for public access)
# Generate this from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=

# Domain configuration
DOMAIN=soullab.life

# Database configuration (if needed for local services)
DATABASE_URL=postgresql://soullab:password@postgres:5432/maia_consciousness

# API configuration
API_PORT=3001

# Service ports
JEREMY_PORT=3000
OLDHEAD_PORT=4321
LORALEE_PORT=3000
MARC_PORT=3000
RUDEBOY_PORT=4323

# Security settings
# Enable HTTPS (set to true for production)
ENABLE_HTTPS=true

# Logging
LOG_LEVEL=info

# Debug settings
DEBUG=false
# ─── Access authorities ──────────────────────────────────────────────────────
# Two SEPARATE allowlists of member UUIDs, comma-separated. Both fail closed:
# unset means nobody passes, never everybody.
#
# ⛔ Do not merge these. FOUNDER_MEMBER_IDS governs founder-PRIVATE surfaces —
# the /api/founder/* console (contacts, tasks, signals, rollout, content), Book
# Studio drafts, workbench uploads, the render pipeline. Adding someone there to
# get them into Lab Tools would hand them the founder's private correspondence
# and unpublished drafts as a side effect. That is why the second list exists
# (founder ruling 2026-09-04); see lib/access/labAccess.ts.
#
# A founder automatically has Lab Tools access and need not be listed twice.
# The union runs one way only: a lab member is NOT thereby a founder.

# The founder. Founder-private surfaces.
FOUNDER_MEMBER_IDS=

# Founding members. The internal laboratory (/labtools) and nothing else.
LAB_ACCESS_MEMBER_IDS=

# EARLY-FIELD-01 — the early Living Field instrument (LivingFieldInstrument)
# and NOTHING else: the Living Field itself stays open to every member.
# A third, separate authority: founders and lab members are NOT admitted
# implicitly — list everyone explicitly. See lib/access/earlyFieldAccess.ts.
#
# EARLY_FIELD_ENABLED must be exactly "true" to open the cohort; anything else
# (unset, "false", "TRUE", "1") is closed. Rollback = set false + restart.
# One malformed id in the list closes the cohort for everyone.
EARLY_FIELD_ENABLED=false
EARLY_FIELD_MEMBER_IDS=

# HOUSE-STUDIO H1 — controlled exposure of explicit Work-context arrival only.
# Writer's Studio itself stays universal. This authority is separate from
# EARLY_FIELD_* and every lab/founder entitlement.
#
# HOUSE_STUDIO_H1_ENABLED must be exactly "true" to open the cohort. Any other
# value is closed. One malformed member id closes the whole cohort.
HOUSE_STUDIO_H1_ENABLED=false
HOUSE_STUDIO_H1_MEMBER_IDS=

# WRITER'S STUDIO FREE / PRO — the `writing.wholeWork` entitlement (lib/auth/wholeWorkEntitlement.ts).
# Off (anything but exactly "true") = no separation: every member may run the whole-book editorial pass.
# On = the Writer's Studio pilot and founder/CTO keep it; otherwise only members.tier = 'pro'.
# Chapter work (chapter reading, scorecard, minimal path) is never gated by this. Rollback = set false + restart.
WS_PRO_GATE_ENABLED=false

# STUDIO HOLDINGS (STUDIO-A-LA-CARTE-01 Phase 1) — lib/auth/studioHoldings.ts, table studio_holding_events.
# Off (anything but exactly "true") = holdings are never read; every gate behaves as before.
# On = while WS_PRO_GATE_ENABLED is also on, a member holding 'studio.writer.pro' gets writing.wholeWork.
# Requires migration 20261112000001 applied first. Rollback = set false + restart.
STUDIO_HOLDINGS_ENABLED=false

# WRITER'S STUDIO DATED BETA GRANTS (founder rulings 2026-11-13, #1800) — lib/writersStudio/betaGrants.ts.
# legacy (default / any other value) = today: ops_contacts writers_studio_beta boolean only; grant table never read.
# transition = an active dated grant OR the boolean admits (issue grants: scripts/writers-studio/beta-grants.ts backfill-legacy).
# dated = only an active dated grant admits. Requires migration 20261113000002. Rollback = set legacy + restart.
WS_BETA_GRANT_MODE=legacy

# Dedicated HMAC secret for practitioner client-portal sessions. Required; do not reuse PHI_ENCRYPTION_KEY.
CLIENT_SESSION_SECRET=

# ─── Independent human safety delivery ───────────────────────────────────────
# At least one of the two independent channels below must be configured before
# S1-S3 or E2 can be closed. These channels are deliberately independent of
# Resend so a mail outage cannot silence member-safety or uptime alerts.
#
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SAFETY_ALERT_PHONE=
#
# Slack webhook
SAFETY_ALERT_SLACK_WEBHOOK_URL=
#
# Never put member message content in these alert transports.

# ─── Auth request origin ─────────────────────────────────────────────────────
# REQUIRED in production behind a reverse proxy (Caddy/Docker). Mutating auth
# routes compare the browser Origin with the framework's own origin, which in a
# container is the internal address, so without this a correct sign-out is
# refused with AUTH_ORIGIN_REFUSED. Comma-separated public origins.
AUTH_ALLOWED_ORIGINS=https://soullab.life

# WRITER'S STUDIO FREE NEW-WORK LIMIT (founder rulings 2026-11-02 "ONE-WORK FREE", 2026-11-13 "Free limits NEW Works only")
# lib/writersStudio/workLimit.ts. Off (anything but exactly "true") = no limit; every create path as before.
# On = a Free writer may start a Work only while holding none; existing Works are never hidden, frozen or changed;
# Pro (pilot / dated beta grant / founder, or members.tier = 'pro') is never limited. Rollback = set false + restart.
WS_FREE_WORK_LIMIT_ENABLED=false

# WRITER'S STUDIO FREE ADMISSION (founder ruling 2026-11-02 "ADMIT FREE NOW"; step B) — lib/writersStudio/freeAdmission.ts.
# Off (default) = only the beta pilot / dated grants / founder enter Writer's Studio, as before.
# On = any signed-in member enters on the Free plan (incl. a tester whose beta grant ended), BUT ONLY while
# WS_FREE_WORK_LIMIT_ENABLED and WS_PRO_GATE_ENABLED are also "true" — otherwise it stays closed (fail-closed).
# Opening this in production is a deploy act under #1938. Rollback = set false + restart.
WS_FREE_ADMISSION_ENABLED=false

# WRITER'S STUDIO — A TASTE OF PRO (founder rulings 2026-11-13; step C2) — lib/writersStudio/proTaste.ts.
# Off (default) = no complimentary pass. On = each Free writer may run the whole-book editorial pass ONCE (letter kept
# forever; given back if the pass fails or is cancelled; never for former beta testers). Requires migration 20261113000003.
WS_PRO_TASTE_ENABLED=false
# "ASK ABOUT PRO" (step C4) — app/api/sovereign/writers-studio/pro-request. Off (default) = 404 and the plans page says
# "Pro isn't open yet". On = members can ask; the founder answers personally (scripts/writers-studio/pro-requests.ts).
# No price, no checkout, no follow-up messages. Requires migration 20261113000004.
WS_PRO_ASK_ENABLED=false

# Writer's Studio MAIA reading allowance, step M1 (#1800): exactly "shadow" records how much MAIA reads per member
# (counts only, never content, never Sanctuary) and refuses nothing. Anything else = off. "enforce" is not built.
WS_MAIA_METER_MODE=
