artifacts/sovereignty-audit*.json
artifacts/*sovereignty*audit*.json

# Keep manifest but not sovereignty audits
artifacts/.manifest.json

# local dev/worktrees
.worktrees/
**/.worktrees/
**/.temp/
*.worktree/

# dev tooling / local seeds
app/api/dev/

# Build artifacts
app/api/backend/dist-minimal/

# local deploy docs/scripts (keep out of feature branches)
Community-Commons/09-Technical/SOVEREIGN_DEPLOYMENT_ARCHITECTURE.md
SOVEREIGN_DEPLOYMENT_GUIDE.md
scripts/sovereign-deploy.sh

# Golden State outputs
/golden-states/golden_state_*.md
!/golden-states/golden_state_20251227_BASELINE.md
/golden-states/test-results/

