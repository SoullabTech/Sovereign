# MAIA-SOVEREIGN .gitignore
# Comprehensive ignore file for Next.js, Node.js, and consciousness technology

# ── iOS / App Store Connect secrets ──────────────────────────────────────────
# Apple private keys (.p8) — NEVER commit these
*.p8
AuthKey_*.p8
# Local env overrides for Fastlane
ios/App/.env.local

# ── Local ops backups (never commit; prod infra is reconciled in source) ──────
Caddyfile.bak.*
docker-compose*.bak.*
*.deploy-bak.*

# Dependencies
# Ignore node_modules whether it is a real directory OR a symlink. The worktree
# shared-tree pattern points node_modules at the main checkout via a symlink, and
# a trailing-slash rule (`node_modules/`) matches directories only — it skips the
# symlink, which is how a self-referential node_modules symlink got committed and
# ELOOP'd every checkout (untracked in #544). The bare form matches both.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Large uploads and PDFs
# Anchored to repo root — see also the rule lower in the file.
/uploads/
*.pdf

# Next.js
.next/
out/
/build/
dist/

# Exception: API routes under app/api/build/ should be tracked
!/app/api/build/
!/app/api/build/**

# Production builds
*.tgz
*.tar.gz

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
.env.docker
.env.*.local
.env.override

# API Keys and Secrets
*.key
*.pem
*.p12
*.jks
*.cert
*.crt
secrets/
keys/
config/secrets.*
credentials.*
serviceAccountKey.json
*-key.json
*.secret
.secrets
secret.yaml
secret.yml

# Cloud provider configurations
.aws/
.gcp/
.azure/
gcloud/
.terraform/
terraform.tfstate*
.tfvars

# Docker secrets
docker-compose.override.yml
docker-compose.*.yml
# …but allow committed sample templates
!docker-compose.production.override.sample.yml
.docker-compose.env

# parcel-bundler cache
.cache
.parcel-cache

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/
# Note: Next.js public/ should be tracked, not ignored

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/
.tmp/

# Supabase CLI cache (build artifacts only, not config)
supabase/.temp/

# Logs
logs
*.log

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
*.backup
*.bak

# Database
*.sqlite
*.sqlite3
*.db

# Vercel
.vercel

# PM2
.pm2

# Cloudflare
.wrangler

# Docker
.docker

# SSL/TLS certificates for soullab.life
ssl/
*.crt
*.pem
*.p12
*.pfx
fullchain.pem
privkey.pem
cert.pem
chain.pem

# MAIA-specific ignores
# Voice processing artifacts
voice_cache/
audio_temp/

# Consciousness session data
consciousness_sessions/private/
session_recordings/

# MAIA knowledge base cache
knowledge_cache/
vectorstore_cache/

# User-specific oracle configurations
user_oracles/
personal_configs/

# Field notes and private documentation
field-notes/private/
personal_insights/

# Temporary MAIA backend files
*maia-backend.js.backup

# Apple corrupted files
*.!*

# Test artifacts
test_results/
*.test.cache
artifacts/*.json
!artifacts/.manifest.json

# Sacred geometry calculations cache
geometry_cache/

# Neural network training data
training_data/
model_checkpoints/

# Large files and directories (GitHub size limits)
# Anchored to repo root — only the top-level filesystem upload tree.
# Otherwise this also catches API route dirs named "uploads" (e.g.
# app/api/book-studio/workbench/uploads/) which need to be tracked.
/uploads/
liquid_test/
apps/web/node_modules/
apps/**/node_modules/
**/node_modules/
*.dylib
*.so
*.dll
*.node

# Desktop build artifacts (Electron)
dist-desktop/
electron-dist/
*.dmg
*.app
*.exe
*.AppImage

# Large PDFs and documents
*.pdf
uploads/**/*.pdf
library/**/*.pdf
**/*.pdf

# Next.js build artifacts
**/.next/
**/next-swc.*.node
**/@next/

# PyTorch and ML libraries
**/torch/
**/pytorch/
**/tensorflow/
# Environment files
.env*
!.env.example

# Mobile build artifacts
# iOS
ios/App/*.xcarchive
ios/App/build/
ios/DerivedData/
ios/build/
